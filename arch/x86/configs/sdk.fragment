# Kleaf normally ties module export protection to symbol trimming. Preserve
# protection of signed module exports while allowing native LTS source layouts
# and all exported symbols. Kleaf stages this generated list in the objtree.
CONFIG_MODULE_SIG_PROTECT_LIST="protected_module_names_list"
# Match build_virt.sh and avoid the ACK defconfig's legacy SHA-1 selection.
# The pinned BoringSSL CMS API supports this digest explicitly.
# CONFIG_MODULE_SIG_SHA1 is not set
CONFIG_MODULE_SIG_SHA256=y
