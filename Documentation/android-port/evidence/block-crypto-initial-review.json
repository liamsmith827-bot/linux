  "records": [
    {
      "commit": "600e29fce0892253b08f858e56b5852494fbd93f",
      "disposition": "partially-adapted-net-state",
      "rationale": "Complete ten-file initial block-crypto patch and documentation examined. Native blk-crypto/profile/fallback split provides capability-based hardware selection, request-owned keyslots, bio contexts and software fallback. Preserve native early alignment/error handling, key-size/type guards, immutable-key identity, synchronous ciphers, cryptographic blank-key RNG, transform publication and wrapped-key rejection. Native read fallback saves original iterator/context, removes the submitted crypto context and restores completion callbacks before decryption, avoiding repeated crypto through layered devices. Do not restore old bio-owned processing_ksm, GFP_ATOMIC work allocation, overwrite-on-success completion status, fixed 64-bit DUNs or fallback-after-hardware-program-error behavior. Existing Android GPL exports/skip flags and e2fc28947c38 allocation rescue remain separately justified; no historical module layout or non-GPL crypto API is recreated.",
      "result_commits": [
        "2fbc2da4ade330c86d97491696f9223c9df7bc8f",
        "e2fc28947c380543e5375eb9919ba13b31d63c09",
        "c45528667984b4e52f1281f8135db42fc8903033"
      ],
      "evidence": [
