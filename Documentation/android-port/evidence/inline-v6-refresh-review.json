  "records": [
    {
      "commit": "cfd7e6c13c2ab62ad3bdd42900b86a36773fe35f",
      "disposition": "partially-adapted-net-state",
      "rationale": "All 33 non-ABI paths of the v5-to-v6 inline-encryption refresh examined in full. Native block crypto supplies separately configured fallback, all original modes, multi-limb DUNs, immutable keys, request-owned keyslots, hash lookup and device capabilities. Native fscrypt supplies prepared-key ownership, DIRECT_KEY support and multi-device setup/eviction; preserve current data-unit geometry, all-device capability checks, bounded F2FS device enumeration and RCU key publication. Keep native clone allocation error propagation, reciprocal context-presence/key checks and every-limb DUN comparison with wrap rejection instead of the historical void clone and incomplete merge checks. Native profiles clear key references even when eviction reports an error and resume devices before locking. Retain the separately reviewed Android metadata skip state, asynchronous zeroout and fallback allocation rescue. UFS files remain exactly LTS; no historical crypto variant API or new platform driver is added. The arm64 XML is an ABI snapshot, omitted under the explicit no-historical-binary-KMI requirement; it is classified by schema and role rather than a line-by-line semantic audit of every generated entry.",
      "result_commits": [
        "2fbc2da4ade330c86d97491696f9223c9df7bc8f",
        "e2fc28947c380543e5375eb9919ba13b31d63c09",
        "c45528667984b4e52f1281f8135db42fc8903033"
      ],
      "evidence": [
        "evidence/inline-v6-refresh-review.json",
        "evidence/fscrypt-initial-refresh-review.json",
        "evidence/crypto-safety-history-review.json",
        "SECURITY.md: Inline-encryption v6 refresh"
      ],
      "patch_sha256": "20757361adc82f9b8e6e1d150c82430db985bd886e94f38208fc4359cfca1e93"
    }
  ],
