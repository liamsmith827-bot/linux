@@ -165,4 +167,18 @@
 #define ANDROID_BACKPORT_USE(number, _new) \
 	_ANDROID_KABI_REPLACE(ANDROID_BACKPORT_RESERVE(number), _new)
 
+#else /* CONFIG_ANDROID_KABI_RESERVE */
