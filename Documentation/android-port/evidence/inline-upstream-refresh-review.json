  "records": [
    {
      "commit": "c2b86b727a415baa58f778dc65d599f352dca00e",
      "disposition": "partially-adapted-net-state",
      "rationale": "Complete 52-file v6-to-upstream inline-encryption refresh and its documentation examined. Native crypto profiles/request contexts implement pointer-identity keyslots, DUN-width capabilities, request preparation/release and front/back merge continuity. Preserve later keyslot release before last bio completion, nonblocking clone/request allocation failures, error propagation and native integrity/crypto exclusion. Native fallback saves completion state and clears submitted crypto context, supports RAW keys only, and uses synchronous ciphers and current initialization cleanup; preserve e2fc28947c38 allocation rescue and c45528667984 metadata-skip cloning. Native fscrypt retains SB_INLINECRYPT, all-device capability checks, current prepared-key publication and per-data-unit geometry; historical NOFS wrapper is superseded by upstream 9dad5feb49a5. Native F2FS keeps physical plus crypto merge checks, compression crypto selection and submitted-folio indices. Keep native DM table profiles and monotonic capabilities, plus the already justified default-key target. Native UFS profile/custom-profile model replaces the historical crypto-vops interfaces; UFS host/core files remain LTS and no physical-platform addition is made. Old source interface names, embedded profile layout and hash/DUN packing are not compatibility requirements for historical binaries.",
      "result_commits": [
        "2fbc2da4ade330c86d97491696f9223c9df7bc8f",
        "e2fc28947c380543e5375eb9919ba13b31d63c09",
        "c45528667984b4e52f1281f8135db42fc8903033"
      ],
      "evidence": [
        "evidence/inline-upstream-refresh-review.json",
        "evidence/inline-v6-refresh-review.json",
        "evidence/dm-crypto-history-review.json",
        "SECURITY.md: Inline-encryption upstream refresh"
      ],
      "patch_sha256": "7af88af3113605cbad7462dcff2a0b74eb34ba74af61b66c8461327245ec4c13"
    }
  ],
